# Copy this file to ".env" and fill it in.  Never commit ".env".

# ---- required ---------------------------------------------------------
# 64 random characters:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_ENV=development            # use "production" on the live server

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foodresq
DB_SSL=0                         # 1 if your cloud database requires SSL

# ---- e-mail (password-reset codes) ------------------------------------
# Gmail: turn on 2-step verification, then create an "App password".
MAIL_EMAIL=
MAIL_APP_PASSWORD=

# ---- access queue ------------------------------------------------------
MAX_ACTIVE_USERS=50              # people logged in at the same time
ACTIVE_IDLE_SECONDS=600          # a slot frees up after this much inactivity
WAITING_STALE_SECONDS=30         # a waiting person who closed the tab is dropped
AVG_SESSION_MINUTES=8            # used only for the "estimated wait" text

# ---- server ------------------------------------------------------------
BEHIND_PROXY=1                   # 1 on Render/Railway/PythonAnywhere/Nginx
# RATE_LIMIT=0                   # ONLY for local load testing, never in production
